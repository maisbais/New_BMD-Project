total_screen_time ~ "Screen Time (Hours/Day)"
)
) %>%
modify_header(stat_1 ~ "**Q1**<br>(&le; 4 hours)<br>N = {n_unweighted} ({style_number(p * 100, digits = 1)}%)") %>%
modify_header(stat_2 ~ "**Q2**<br>(> 4 hours to &le; 6 hours)<br>N = {n_unweighted} ({style_number(p * 100, digits = 1)}%)") %>%
modify_header(stat_3 ~ "**Q3**<br>(> 6 hours to &le; 9 hours)<br>N = {n_unweighted} ({style_number(p * 100, digits = 1)}%)") %>%
modify_header(stat_4 ~ "**Q4**<br>(> 9 hours)<br>N = {n_unweighted} ({style_number(p * 100, digits = 1)}%)") %>%
modify_footnote(all_stat_cols() ~ NA)
# Female Table to combine
t1_female_comb <- tbl_svysummary(
data = design_females,
by = screen_quart,
include = c(total_screen_time, RIDAGEYR, age_cat, RIDRETH3, fpl_cat, parent_edu, fsdch_2cat),
missing = "no",
statistic = list(
total_screen_time ~ "{mean} ({mean.std.error})",
all_continuous()  ~ "{mean} ({mean.std.error})",
all_categorical() ~ "{n_unweighted} ({p}%)"
),
digits = list(
all_categorical() ~ c(0, 1),
all_continuous()  ~ c(2, 2)
),
label = list(
total_screen_time ~ "Screen Time (Hours/Day)"
)
) %>%
modify_header(stat_1 ~ "**Q1**<br>(&le; 4 hours)<br>N = {n_unweighted} ({style_number(p * 100, digits = 1)}%)") %>%
modify_header(stat_2 ~ "**Q2**<br>(> 4 hours to &le; 6 hours)<br>N = {n_unweighted} ({style_number(p * 100, digits = 1)}%)") %>%
modify_header(stat_3 ~ "**Q3**<br>(> 6 hours to &le; 9 hours)<br>N = {n_unweighted} ({style_number(p * 100, digits = 1)}%)") %>%
modify_header(stat_4 ~ "**Q4**<br>(> 9 hours)<br>N = {n_unweighted} ({style_number(p * 100, digits = 1)}%)") %>%
modify_footnote(all_stat_cols() ~ NA)
# Combined Table
t1_combined <- tbl_merge(
tbls = list(t1_male_comb, t1_female_comb),
tab_spanner = c("**Males (n = 2,044)**", "**Females (n = 1,953)**")
) %>%
modify_caption(
caption = "Table 1. NHANES 2013-2018 distribution of characteristics among U.S. children 8 to 17 years of age stratified by sex and daily screen time quartiles"
) %>%
as_gt() %>%
gt::tab_source_note(
source_note = "Continuous variables are presented as weighted mean (SE) and categorical variables are presented as unweighted n (weighted %). Abbreviations: NHANES, National Health and Nutrition Examination Survey; SE, Standard Error; PIR, Poverty Income Ratio."
)
t1_combined
View(t1_combined)
t1_combined
## Adding a combined column to Table 1
## Overall Table (Total column)
t1_total_comb <- tbl_svysummary(
data = subpop_design,   # your full survey design object
include = c(total_screen_time, RIDAGEYR, age_cat, RIDRETH3, fpl_cat, parent_edu, fsdch_2cat),
missing = "no",
statistic = list(
total_screen_time ~ "{mean} ({mean.std.error})",
all_continuous()  ~ "{mean} ({mean.std.error})",
all_categorical() ~ "{n_unweighted} ({p}%)"
),
digits = list(
all_categorical() ~ c(0, 1),
all_continuous()  ~ c(2, 2)
),
label = list(
total_screen_time ~ "Screen Time (Hours/Day)"
)
) %>%
modify_header(
label ~ "**Variable**",
stat_0 ~ "**Total**<br>N = {n_unweighted}"
) %>%
modify_footnote(all_stat_cols() ~ NA)
## Merge all three tables
t1_combined_full <- tbl_merge(
tbls = list(t1_total_comb, t1_male_comb, t1_female_comb),
tab_spanner = c("**Total**", "**Males (n = 2,044)**", "**Females (n = 1,953)**")
) %>%
modify_caption(
caption = "Table 1. NHANES 2013-2018 distribution of characteristics among U.S. children 8 to 17 years of age stratified by sex and daily screen time quartiles"
) %>%
as_gt() %>%
gt::tab_source_note(
source_note = "Continuous variables are presented as weighted mean (SE) and categorical variables are presented as unweighted n (weighted %). Abbreviations: NHANES, National Health and Nutrition Examination Survey; SE, Standard Error; PIR, Poverty Income Ratio."
)
t1_combined_full
gt::gtsave(t1_combined_full, filename = "Table1_Combined.png") #save combined as png
gt::gtsave(t1_combined_full, filename = "Table1_Combined_full.png") #save combined as png
svymean(~DXDSTBMD, design = subpop_design)
library(dplyr)
library(readr)
library(tidyr)
install.packages("cdcanthro")
# install.packages("cdcanthro")
#=========================================================================
# I will be using the dataset from P3- "Analytic Sample_PartA"
# This dataset includes everybody from the 3 waves, not just our study population
nhanes_clean <- readRDS(here("data", "processed", "nhanes_bmd_pediatric_master.rds"))
library(here)
# install.packages("cdcanthro")
#=========================================================================
# I will be using the dataset from P3- "Analytic Sample_PartA"
# This dataset includes everybody from the 3 waves, not just our study population
nhanes_clean <- readRDS(here("data", "processed", "nhanes_bmd_pediatric_master.rds"))
?cdcanthro
View(nhanes_clean)
# Step 1: create height-adjusted z-scores with package cdcanthro
nhanes_clean <- cdcanthro::cdcanthro(nhanes_clean,
age = RIDEXAGM,
ht = BMXHT)
?tabyl
library(janitor)
nhanes_clean |> tabyl(RIDAGEYR, age_band)
nhanes_clean <- nhanes_clean |>
mutate(
filter(age_band >= 8, age_band <= 17) |>
group_by(age_band, sex) |>
summarize(
mean_group_bmd = mean(DXDSTBMD, na.rm = TRUE),
sd_group_bmd = sd(DXDSTBMD, na.rm = TRUE),
.groups = "drop"
)
)
rlang::last_trace()
nhanes_band <- nhanes_clean |>
filter(age_band >= 8, age_band <= 17) |>
group_by(age_band, sex) |>
summarize(
mean_group_bmd = mean(DXDSTBMD, na.rm = TRUE),
sd_group_bmd   = sd(DXDSTBMD, na.rm = TRUE),
.groups = "drop"
)
View(nhanes_band)
# Step 3: Calculate the unadjusted (for HAZ 😊) BMD-Z
nhanes_clean <- nhanes_clean |>
left_join(nhanes_band, by = c("age_band", "sex")) |>
mutate(
bmd_z_unadjusted = (DXDSTBMD - mean_group_bmd) / sd_group_bmd
)
# Step 4: create a linear model where the dependent variable is unadjusted BMD,
# independent variable is HAZ
bmd_model <- lm(bmd_z_unadjusted ~ haz0,
data = nhanes_clean)
# Step 5: use the model to predict the residual for each observation
#(whatever part of the child's BMD Z-score isn't explained by their height)
# and the SD for the residuals.
library(broom) # I think I can just use the augment function for this...
aug_model <- augment(bmd_model, data = nhanes_clean)
aug_model <- augment(bmd_model)
glimpse(aug_model)
?augment
resid_sd <- sd(aug_model$.resid, na.rm = TRUE)
# The final HAZ-adjusted BMD Z-score will then essentially be:
#individuals predicted residuals/the SD of residuals
nhanes_clean <- aug_model %>%
mutate(
tblh_bmd_z_adj = .resid / resid_sd
)
sum(!is.na(nhanes_clean$tblh_bmd_z_adj))
nhanes_clean |>
tabyl(age_band, tblh_bmd_z_adj)
remove(resid_sd)
remove(nhanes_clean)
